{
  "name": "@penciled/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Penciled shared contracts v1: JSON Schema (source of truth), generated zod types, rules.json and thresholds formats.",
  "type": "module",
  "main": "./ts/index.ts",
  "types": "./ts/index.ts",
  "exports": {
    ".": "./ts/index.ts",
    "./schema/*": "./schema/*",
    "./rules/rules.json": "./rules/rules.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node tools/generate.mjs",
    "check:generated": "node tools/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tools/generate.mjs --check && node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
